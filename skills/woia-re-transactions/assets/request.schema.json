{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Real Estate transaction command envelope",
  "type": "object",
  "properties": {
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "negotiation.record",
        "offer.record",
        "offer.supersede",
        "reservation.create",
        "reservation.update",
        "reservation.release",
        "reservation.expire",
        "sale-transaction.milestone.record",
        "sale-transaction.close-record"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "now": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "required": [
        "authenticated",
        "organization",
        "actor",
        "purpose",
        "department",
        "actions",
        "resources",
        "current",
        "policy_revision",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "authenticated": {
          "const": true
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "department": {
          "enum": [
            "Sales",
            "Leasing"
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current": {
          "const": true
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "valid_until": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source_authority": {
      "type": "object",
      "required": [
        "organization",
        "map_revision",
        "writer",
        "source",
        "fact_kinds",
        "targets",
        "current",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "map_revision": {
          "type": "string",
          "minLength": 1
        },
        "writer": {
          "const": "woia-re-transactions"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "fact_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current": {
          "const": true
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "valid_until": {
          "type": "string",
          "minLength": 1
        },
        "conflict": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fact_kind": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "fresh_until": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "reference",
        "version",
        "fact_kind",
        "recorded_at",
        "fresh_until"
      ],
      "additionalProperties": false
    },
    "human_decision": {
      "type": "object",
      "required": [
        "principal",
        "kind",
        "organization",
        "action",
        "target",
        "payload_digest",
        "policy_revision",
        "current",
        "reference",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "competent-human"
        },
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_revision": {
          "type": "string",
          "minLength": 1
        },
        "current": {
          "const": true
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "string",
          "minLength": 1
        },
        "valid_until": {
          "type": "string",
          "minLength": 1
        },
        "revoked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "organization",
    "purpose",
    "action",
    "target",
    "operation_id",
    "expected_revision",
    "now",
    "payload",
    "authority",
    "source_authority",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "negotiation.record"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "property_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "participants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "subject_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "subject_ref",
                    "role"
                  ],
                  "additionalProperties": false
                }
              },
              "terms_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "property_refs",
              "participants",
              "terms_ref"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "offer.record"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "negotiation_ref": {
                "type": "string",
                "minLength": 1
              },
              "terms_ref": {
                "type": "string",
                "minLength": 1
              },
              "valid_until": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "negotiation_ref",
              "terms_ref",
              "valid_until"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "offer.supersede"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "negotiation_ref": {
                "type": "string",
                "minLength": 1
              },
              "terms_ref": {
                "type": "string",
                "minLength": 1
              },
              "valid_until": {
                "type": "string",
                "minLength": 1
              },
              "supersedes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "negotiation_ref",
              "terms_ref",
              "valid_until",
              "supersedes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reservation.create"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "negotiation_ref": {
                "type": "string",
                "minLength": 1
              },
              "offer_ref": {
                "type": "string",
                "minLength": 1
              },
              "property_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mandate_ref": {
                "type": "string",
                "minLength": 1
              },
              "mandate_version": {
                "type": "integer",
                "minimum": 1
              },
              "conditions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "condition_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "condition_id",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "expires_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "negotiation_ref",
              "offer_ref",
              "property_refs",
              "mandate_ref",
              "mandate_version",
              "conditions",
              "expires_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reservation.update"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "properties": {
                    "condition_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "condition_id",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "expires_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "conditions",
              "expires_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reservation.release"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reservation.expire"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "sale-transaction.milestone.record"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "negotiation_ref": {
                "type": "string",
                "minLength": 1
              },
              "milestone_code": {
                "enum": [
                  "signature",
                  "closing",
                  "money",
                  "possession"
                ]
              },
              "occurrence_id": {
                "type": "string",
                "minLength": 1
              },
              "fact_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "negotiation_ref",
              "milestone_code",
              "occurrence_id",
              "fact_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "sale-transaction.close-record"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "negotiation_ref": {
                "type": "string",
                "minLength": 1
              },
              "closing_fact_ref": {
                "type": "string",
                "minLength": 1
              },
              "occurred_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "negotiation_ref",
              "closing_fact_ref",
              "occurred_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "human_decision"
        ]
      }
    }
  ]
}
